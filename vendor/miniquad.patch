+                .offset(screen as isize))
+            .root;
+            connection.window = (connection.lib.XCreateWindow)(
+                display,
+                root,
+                0,
+                0,
+                8,
+                8,
+                0,
+                0,
+                0,
+                std::ptr::null_mut(),
+                0,
